# Normalise line endings so a clone on any platform produces the same blobs.
* text=auto eol=lf

*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.pot text eol=lf
*.svg text eol=lf

# Files that never belong in a distributed plugin ZIP.
/.gitattributes export-ignore
/.gitignore     export-ignore
